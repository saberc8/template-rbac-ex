VITE_APP_DEFAULT_ROUTE = /workbench
VITE_APP_PUBLIC_PATH = /
VITE_APP_API_BASE_URL = /api
# 与 pc-admin-vue3 保持一致：登录时作为 clientId 传入
VITE_CLIENT_ID = ef51c9a3e9046c4f2ea45142c8a8344a
# 开发代理目标（Vite dev server：/api -> target，并移除 /api 前缀）
VITE_APP_API_PROXY_TARGET = http://localhost:14396
# 菜单管理页（/system/menu/*）目标数据集：react(默认)/vue3
# - react：对应 /menu 使用的数据集（sys_menu.frontend='react'）
# - vue3：对应 pc-admin-vue3 使用的数据集（sys_menu.frontend='vue3'）
VITE_APP_ADMIN_FRONTEND_TYPE = react
