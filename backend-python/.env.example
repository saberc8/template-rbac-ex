## Backend (python)

# App env (local/dev/production). production will skip loading .env
APP_ENV=local

# HTTP
HTTP_PORT=14396

# Admin frontend type: vue3/react
ADMIN_FRONTEND_TYPE=vue3

# Database dialect: postgres/mysql
DB_DIALECT=postgres

# Database migrate
# - 生产环境默认不建议在服务启动时执行隐式 DDL
# - 开发环境默认开启（如需关闭可显式设置为 0/false）
# DB_AUTO_MIGRATE=1

# PostgreSQL / MySQL (shared)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PWD=123456
DB_NAME=ex_admin_v1

# PostgreSQL only
DB_SSLMODE=disable

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PWD=
REDIS_DB=0

# Local file storage (optional)
FILE_STORAGE_DIR=./data/file
# Local file url prefix (optional)
# FILE_BASE_URL=/file

# Security (required)
# ⚠️ 密码/密钥字段不再使用 RSA 加密，生产环境请务必启用 HTTPS。
AUTH_JWT_SECRET=asdasdasifhueuiwyurfewbfjsdafjk

# Syslog middleware
# LOG_BODY_MAX_BYTES=4096
# LOG_SKIP_BODY_PATHS=/auth/login

# Captcha (optional)
# CAPTCHA_IMG_HEIGHT=60
# CAPTCHA_IMG_WIDTH=200
# CAPTCHA_NOISE_COUNT=0
# CAPTCHA_SHOW_LINE_OPTIONS=0
# CAPTCHA_SOURCE=23456789
