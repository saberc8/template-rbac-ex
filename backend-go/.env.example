## Backend (admin)

# App env (local/dev/production). production will skip loading .env
APP_ENV=local

# HTTP
HTTP_PORT=14398

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PWD=123456
DB_NAME=go_admin_v1
DB_SSLMODE=disable

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PWD=
REDIS_DB=0

# Security (required)
# ⚠️ 密码/密钥字段不再使用 RSA 加密，生产环境请务必启用 HTTPS。
AUTH_JWT_SECRET=

# Syslog middleware
# LOG_BODY_MAX_BYTES=4096
# LOG_SKIP_BODY_PATHS=/auth/login

# Captcha (optional) - make /captcha/image clearer or more strict
# CAPTCHA_IMG_HEIGHT=60
# CAPTCHA_IMG_WIDTH=200
# CAPTCHA_NOISE_COUNT=0
# CAPTCHA_SHOW_LINE_OPTIONS=0
# CAPTCHA_SOURCE=23456789
