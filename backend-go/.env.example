## Backend (admin)

# App env (local/dev/production). production will skip loading .env
APP_ENV=local

# HTTP
HTTP_PORT=4398

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PWD=123456
DB_NAME=nv_admin_v1
DB_SSLMODE=disable

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PWD=
REDIS_DB=0

# Security (required)
# 推荐优先使用文件路径，避免手动处理 Base64。
# AUTH_RSA_PRIVATE_KEY_FILE supports PEM:
# - PKCS#8: -----BEGIN PRIVATE KEY-----
# - PKCS#1: -----BEGIN RSA PRIVATE KEY-----
AUTH_RSA_PRIVATE_KEY_FILE=./dev_rsa_private_key.pem
#
# 兼容旧配置：DER Base64（支持 PKCS#8/PKCS#1）
AUTH_RSA_PRIVATE_KEY=
AUTH_JWT_SECRET=

# Syslog middleware
# LOG_BODY_MAX_BYTES=4096
# LOG_SKIP_BODY_PATHS=/auth/login

# Captcha (optional) - make /captcha/image clearer or more strict
# CAPTCHA_IMG_HEIGHT=60
# CAPTCHA_IMG_WIDTH=200
# CAPTCHA_NOISE_COUNT=0
# CAPTCHA_SHOW_LINE_OPTIONS=0
# CAPTCHA_SOURCE=23456789
